{
  "name": "garimpo",
  "version": "0.0.0",
  "private": true,
  "description": "Garimpo: análise de logs que não sai da sua máquina.",
  "license": "MIT",
  "author": "Lucas Gracindo",
  "homepage": "https://garimpo-fbfsk7x2q9.lucasgracindo73.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuGracindo/Garimpo.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "gen:logs": "node scripts/gen-logs.ts",
    "bench:read": "node scripts/bench-read.ts",
    "bench:analyze": "node scripts/bench-analyze.ts",
    "audit": "npm audit --audit-level=high",
    "verify:laudo": "node scripts/verify-laudo.ts",
    "e2e": "node scripts/e2e.ts",
    "check:secrets": "node scripts/check-secrets.ts",
    "check:live": "node scripts/check-live.ts"
  },
  "dependencies": {
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
