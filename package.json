{
  "name": "garimpo",
  "version": "0.0.0",
  "private": true,
  "description": "Garimpo: análise de logs que não sai da sua máquina.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "gen:logs": "node scripts/gen-logs.ts",
    "bench:read": "node scripts/bench-read.ts",
    "bench:analyze": "node scripts/bench-analyze.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
